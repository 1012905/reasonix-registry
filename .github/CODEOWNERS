/plugins/                           @esengine @SivanCola

# The gates and the trust root decide what the gates are allowed to pass.
/schemas/                           @esengine @SivanCola
/scripts/                           @esengine @SivanCola
/registry.pub                       @esengine @SivanCola
/revoked.json                       @esengine @SivanCola
/.github/workflows/                 @esengine @SivanCola
