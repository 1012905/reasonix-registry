{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonix.io/registry/schemas/plugin.schema.json",
  "title": "plugins/<id>/plugin.json",
  "description": "Registry descriptor for a plugin entry. The kernel package lives in package/ beside it, with its own reasonix-plugin.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "version", "license", "minVersion", "compat"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 280
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]{2,64}$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "repository": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "minVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "frontends"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["windows", "macos", "linux", "any"]
          }
        },
        "frontends": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["studio", "cli"]
          }
        }
      }
    },
    "binaries": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "url", "sha256", "size"],
        "properties": {
          "platform": {
            "type": "string",
            "pattern": "^(any|windows|macos|linux)(-(amd64|arm64))?$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
