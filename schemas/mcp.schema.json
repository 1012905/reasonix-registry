{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonix.io/registry/schemas/mcp.schema.json",
  "title": "mcp/<id>.json",
  "description": "One MCP server manifest. Values reach the user's machine after manual review, so keys are closed and no credential may appear here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "version", "license", "minVersion", "compat", "transport"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 280
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]{2,64}$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "repository": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "minVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "frontends"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["windows", "macos", "linux", "any"]
          }
        },
        "frontends": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["studio", "cli"]
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["stdio", "http"]
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        }
      }
    }
  }
}
