{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasonix.io/registry/schemas/theme.schema.json",
  "title": "theme.json",
  "description": "A theme pack: named colours per scheme plus optional shape recipes and a background image. The kernel reads the same file; registry fields ride beside its own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "license", "minVersion", "compat", "tokens"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 280
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]{2,64}$"
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "repository": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "minVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "frontends"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["windows", "macos", "linux", "any"]
          }
        },
        "frontends": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["studio", "cli"]
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "required": ["light", "dark"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recipes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "density": {
          "type": "string",
          "enum": ["compact", "comfortable"]
        },
        "corners": {
          "type": "string",
          "enum": ["sharp", "slight", "round"]
        }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^(background\\.(webp|png|jpg|jpeg))?$"
        },
        "focusX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "focusY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "safeArea": {
          "type": "string",
          "enum": ["left", "center", "right"]
        },
        "homeOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "taskOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "overlayStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "textGlow": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "sky": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ray": {
          "type": "string",
          "maxLength": 32
        },
        "cloud": {
          "type": "string",
          "maxLength": 32
        },
        "cloudLit": {
          "type": "string",
          "maxLength": 32
        },
        "rayAlpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cloudAlpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
